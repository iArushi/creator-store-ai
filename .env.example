# Required for AI profile + opportunity generation + vision analysis
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional override for screenshot/image analysis (defaults to OPENAI_MODEL)
# OPENAI_VISION_MODEL=gpt-4o-mini

# Optional but recommended — Tavily search + extract for market research and public URLs
# Without this key, URL ingestion fails honestly and opportunities stay AI estimates
TAVILY_API_KEY=

# Optional — Instagram Login (Meta) only if you want the “Connect Instagram” path.
# The MVP works fully without these: use a short description + uploads instead.
# App Dashboard → Instagram → API setup with Instagram login → Business login settings
# META_APP_ID=
# META_APP_SECRET=
# Must exactly match an OAuth redirect URI registered in Meta
# INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
# Optional: cookie encryption secret (defaults to META_APP_SECRET)
# INSTAGRAM_SESSION_SECRET=
# Optional Graph API version (defaults to v22.0)
# INSTAGRAM_GRAPH_VERSION=v22.0
